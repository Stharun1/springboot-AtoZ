# ==========================================
# Comprehensive Git Ignore for Spring Boot & Java
# Protects sensitive info, secrets, build artifacts, and IDE settings
# ==========================================

# ------------------------------------------
# Sensitive Files, Keys & Local Configurations
# ------------------------------------------
.env
.env.*
*.env
*.pem
*.key
*.pkcs12
*.p12
*.jks
*.crt
*.csr
*.der
secrets.properties
credentials.json
application-local.properties
application-local.yml
application-local.yaml
application-secrets.properties
application-secrets.yml
application-secrets.yaml
application-dev.properties

# ------------------------------------------
# Maven / Build Artifacts
# ------------------------------------------
target/
**/target/
build/
**/build/
out/
**/out/
bin/
**/bin/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# ------------------------------------------
# IDE & Editor Specific Files
# ------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
.idea_modules/

# Eclipse
.classpath
.project
.settings/
.factorypath
.target

# VS Code
.vscode/

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/

# ------------------------------------------
# Operating System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------------------
# Log Files & Crash Reports
# ------------------------------------------
*.log
logs/
**/logs/
hs_err_pid*
replay_pid*
